# PostHub 2.0 - Backend Dockerfile
FROM node:20-alpine

WORKDIR /app

# Install dependencies first for efficient layer caching
COPY backend/package*.json ./
RUN npm ci --only=production

# Copy backend source
COPY backend/ ./

# Expose API port
EXPOSE 5000

ENV NODE_ENV=production

# Run API server
CMD ["node", "server.js"]
