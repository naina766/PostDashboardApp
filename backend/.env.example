# ===================================================
# POSTHUB 4.0 BACKEND ENVIRONMENT CONFIGURATION
# Copy this file to .env and replace placeholders
# NEVER commit .env to version control!
# ===================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# MongoDB Database Connection
# Local: mongodb://localhost:27017/posthub
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/posthub

# JWT Authentication Secrets
# Generate strong 64-character secret in production using: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=development_super_secret_jwt_key_posthub_replace_in_prod

# Allowed Frontend Origins for CORS (comma-separated if multiple)
# Development: http://localhost:5173,http://localhost:3000
# Production: https://your-posthub-frontend.vercel.app
FRONTEND_URL=http://localhost:5173

# Cloudinary Storage Configuration (Required for cloud image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Rate Limiting Overrides (Optional)
RATE_LIMIT_GLOBAL_MAX=1000
RATE_LIMIT_AUTH_MAX=50
RATE_LIMIT_CONTENT_MAX=60
